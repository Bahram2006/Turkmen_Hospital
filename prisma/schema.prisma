generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum DeviceType {
  DESKTOP_EXE
  MOBILE_ANDROID
  MOBILE_IOS
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum HealthReportStatus {
  NEW
  REVIEWED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      Role     @default(PATIENT)
  isOnline  Boolean  @default(false)
  lastSeen  DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  devices              UserDevice[]
  doctorProfile        DoctorProfile?
  appointmentsPatient  Appointment[]  @relation("PatientAppointments")
  appointmentsDoctor   Appointment[]  @relation("DoctorAppointments")
  reportsPatient       HealthReport[] @relation("PatientReports")
  reportsDoctor        HealthReport[] @relation("DoctorReports")
  prescriptionsPatient Prescription[] @relation("PatientPrescriptions")
  prescriptionsDoctor  Prescription[] @relation("DoctorPrescriptions")

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserDevice {
  id          String     @id @default(uuid())
  userId      String
  deviceToken String     @unique
  deviceType  DeviceType
  lastActive  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceToken])
  @@map("user_devices")
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  icon String

  doctors DoctorProfile[]

  @@map("categories")
}

model DoctorProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  categoryId      String // Maps to specialization
  bio             String?
  experienceYears Int     @default(0)
  consultationFee Decimal @default(0.00) @db.Decimal(10, 2) // Added per requirements
  workStartTime   String
  workEndTime     String
  isAvailable     Boolean @default(true)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("doctor_profiles")
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String // Links to User (Role.DOCTOR)
  appointmentDate DateTime // The date of the appointment
  startTime       String // e.g., "09:00"
  endTime         String // e.g., "09:30"
  status          AppointmentStatus @default(PENDING)
  notes           String?
  cancelReason    String?
  createdAt       DateTime          @default(now())

  patient User @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@map("appointments")
}

model HealthReport {
  id                  String             @id @default(uuid())
  patientId           String
  doctorId            String
  bodyPartCoordinates Json // Stores JSON coordinates
  description         String
  audioNoteUrl        String?
  status              HealthReportStatus @default(NEW)
  createdAt           DateTime           @default(now())

  patient User @relation("PatientReports", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorReports", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@map("health_reports")
}

model Prescription {
  id            String   @id @default(uuid())
  patientId     String
  doctorId      String
  medicineName  String
  dosage        String
  timesPerDay   Int
  scheduleTimes String[] // Array of strings, e.g., ["08:00", "14:00", "20:00"]
  startDate     DateTime
  endDate       DateTime

  patient User @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorPrescriptions", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@map("prescriptions")
}
